# Copy to .env.local (or .env.development) and adjust for your machine.
# Vite only exposes variables prefixed with VITE_.

# TTS API Configuration
# Points to the local XTTS v2 server running the Deckard Cain voice model
VITE_TTS_API_URL=http://localhost:5002/api/tts
VITE_TTS_VOICE_MODEL=deckard_cain

# Game Settings
VITE_DEBUG_PHYSICS=false
VITE_DEBUG_PATH=false
VITE_STARTING_LEVEL=1

# Pin a specific dungeon layout. Leave unset to derive the seed from the depth.
# VITE_DUNGEON_SEED=1337
